[configuration]
entry_symbol = "zenscape_kernels_init"
compatibility_minimum = "4.7"

[libraries]
macos.debug.arm64 = "res://native/terrain_kernels/bin/libzenscape_kernels.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://native/terrain_kernels/bin/libzenscape_kernels.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://native/terrain_kernels/bin/libzenscape_kernels.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://native/terrain_kernels/bin/libzenscape_kernels.macos.template_release.x86_64.dylib"
windows.debug.x86_64 = "res://native/terrain_kernels/bin/zenscape_kernels.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/terrain_kernels/bin/zenscape_kernels.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://native/terrain_kernels/bin/zenscape_kernels.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://native/terrain_kernels/bin/zenscape_kernels.windows.template_release.arm64.dll"
linux.debug.x86_64 = "res://native/terrain_kernels/bin/libzenscape_kernels.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/terrain_kernels/bin/libzenscape_kernels.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://native/terrain_kernels/bin/libzenscape_kernels.linux.template_debug.arm64.so"
linux.release.arm64 = "res://native/terrain_kernels/bin/libzenscape_kernels.linux.template_release.arm64.so"
