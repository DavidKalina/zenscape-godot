var original_heights := PackedFloat32Array()
var points := PackedVector2Array()
var _face_grass := PackedColorArray()
var _palette := preload("res://scripts/native_terrain_palette.gd").new()
var vertex_ids := PackedInt32Array()
var _arrays: Array
var _buckets := {}
