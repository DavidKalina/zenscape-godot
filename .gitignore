.godot/
.DS_Store
builds/

# Local agent checkouts and disposable validation output.
.claude/worktrees/

# Generated documentation captures stay on the machine that recorded them.
# Keep Markdown, measurements, fixtures, and capture scripts in Git.
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/docs/**/*.webp
/docs/**/*.gif
/docs/**/*.mp4
/docs/**/*.mov
/docs/**/*.webm
/docs/**/*.wav
/docs/**/*.mp3
/docs/**/*.ogg
/docs/**/*.import
/docs/**/*.log

# Blender source projects belong in Git; backup copies and preview renders do not.
*.blend[0-9]*
/art/blender/**/*.png
/art/blender/**/*.jpg
/art/blender/**/*.jpeg
/art/blender/**/*.webp
/art/blender/**/*.mp4
/art/blender/**/*.mov
/art/blender/**/*.webm

# Do not ignore assets/, *.blend, or Godot *.uid / asset *.import files:
# those are game content, editable source art, and resource/import settings.

# Local film and still captures
captures/

# Python bytecode from the Blender scripts.
__pycache__/

# Throwaway drivers and checks (tools/README.md); Godot skips it (.gdignore).
/scratch/
